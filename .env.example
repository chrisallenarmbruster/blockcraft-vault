# Blockcraft Vault — wallet application, PostgreSQL and logical backups.

# Application
DOCKER_REGISTRY="registry.rev4labs.com"
DOCKER_IMAGE_NAME="blockcraft-vault"
APP_VERSION="0.1.8"
APP_REPLICAS="1"
PORT="8000"
SESSION_SECRET=""
VITE_BLOCKCRAFT_NODE_URL="https://node1.blockcraft.rev4labs.com"

# Database
POSTGRES_VERSION="16.3-bookworm"
POSTGRES_DB="blockcraft-vault"
POSTGRES_USER=""
POSTGRES_PASSWORD=""
DATABASE_URL=""

# Backups
BACKUP_REPLICAS="1"
POSTGRES_BACKUP_SCHEDULE="15 3 * * 0"
POSTGRES_BACKUP_TIMEZONE="America/Chicago"
POSTGRES_BACKUP_KEEP_MINUTES="10080"
POSTGRES_BACKUP_KEEP_DAYS="7"
POSTGRES_BACKUP_KEEP_WEEKS="4"
POSTGRES_BACKUP_KEEP_MONTHS="3"
