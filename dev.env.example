# Blockcraft Vault — development
# Save as server/.env. Used by the server, Vite and image-build script.

# Application
PORT="8000"
SESSION_SECRET=""

# Local database
DATABASE_URL="postgres://localhost/blockcraft-vault"

# Blockchain
VITE_BLOCKCRAFT_NODE_URL="https://node1.blockcraft.rev4labs.com"

# Image publishing
DOCKER_REGISTRY="registry.rev4labs.com"
DOCKER_IMAGE_NAME="blockcraft-vault"
